# Copy to .env for a production-like local Docker stack. Never commit real secrets.
APP_ENV=staging
APP_VERSION=0.9.0-beta
SECRET_KEY=replace-with-a-long-random-local-staging-secret
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

JOB_EXECUTION_MODE=redis
RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://redis:6379/0

DATASET_STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=datapilot
S3_ACCESS_KEY_ID=datapilot
S3_SECRET_ACCESS_KEY=replace-with-a-local-minio-password
S3_REGION=us-east-1
S3_USE_SSL=false
MINIO_ROOT_USER=datapilot
MINIO_ROOT_PASSWORD=replace-with-a-local-minio-password

# Console delivery is intentional for local HTTP staging only.
EMAIL_PROVIDER=console
ALLOW_CONSOLE_EMAIL_LINKS=true
ALLOW_INSECURE_STAGING_COOKIES=true
BILLING_PROVIDER=none
PRICING_CURRENCY=INR
FREE_PRICE_MONTHLY=0
PRO_PRICE_MONTHLY=
BUSINESS_PRICE_MONTHLY=
PRO_TRIAL_ENABLED=true
PRO_TRIAL_DAYS=14
PLAN_LIMIT_WARNING_PERCENT=75
PLAN_LIMIT_CRITICAL_PERCENT=90
