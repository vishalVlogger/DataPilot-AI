AI_PROVIDER=mock
MAX_UPLOAD_SIZE_MB=25
MAX_ROWS=250000
MAX_COLUMNS=500
MAX_AI_SAMPLE_ROWS=100
MAX_CHART_ROWS=100
MAX_CATEGORY_ANALYSIS=100
MAX_QUALITY_EXAMPLES=5
SEMANTIC_YEAR_MIN=1900
SEMANTIC_YEAR_TOLERANCE=2
HIGH_CARDINALITY_MIN_UNIQUE=5
HIGH_CARDINALITY_RATIO=0.5
PANDAS_ROW_THRESHOLD=50000
DUCKDB_ROW_THRESHOLD=50000
MAX_ANALYSIS_ROWS=1000000
FORCED_EXECUTION_ENGINE=
DATA_STORAGE_DIR=.data
DATASET_STORAGE_ROOT=.data
PARQUET_COMPRESSION=zstd
DATABASE_URL=sqlite:///./datapilot.db
ENABLE_PDF_REPORTS=true
BACKGROUND_JOBS_ENABLED=true
CORS_ORIGINS=http://localhost:3000
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
AI_TIMEOUT_SECONDS=30
